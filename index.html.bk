<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Árido — Café de especialidad del norte de Chile</title>
<meta name="description" content="Árido: café de especialidad tostado en Antofagasta y despachado a todo Chile. Lo mejor de los campos de Colombia y Etiopía.">
<link rel="icon" type="image/svg+xml" href="assets/favicon.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,300;0,400;0,700;0,900;1,400&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,600&display=swap" rel="stylesheet">

<!-- ?v= fuerza a recargar css y js al publicar: sin el, el navegador
     reutiliza la copia en cache y se sigue viendo la version anterior. -->
<link rel="stylesheet" href="styles.css?v=202609102104">
</head>
<body>

<nav id="nav">
  <div class="nav-pill">
    <a href="#top" class="nav-brand">
      <img src="assets/navbar-icon.svg" alt="" class="nav-brand-icon">
      <img src="assets/arido-navbar.svg" alt="Árido" class="nav-brand-word" id="navBrandWord">
    </a>
    <div class="nav-links">
      <a href="#nosotros">Nuestra historia</a>
      <a href="#tueste">Nuestros cafés</a>
      <a href="#contacto">Contacto</a>
    </div>
    <a href="#tueste" class="btn btn-accent nav-cta">Comprar café</a>
    <button class="burger" id="burgerBtn" aria-label="Abrir menú">☰</button>
  </div>
</nav>

<div class="mobile-menu" id="mobileMenu">
  <button class="close-btn" id="closeMenuBtn" aria-label="Cerrar menú">✕</button>
  <a href="#nosotros">Nuestra historia</a>
  <a href="#tueste">Nuestros cafés</a>
  <a href="#contacto">Contacto</a>
  <a href="https://wa.me/56972497925" target="_blank" rel="noopener">WhatsApp</a>
</div>

<!-- Sky stage: the desert scene is a child of this wrapper, not of #nosotros, so the
     sky and the moon start at the very top of the page and the scene descends into the
     second section. The terrain still lands on the wrapper's bottom edge, which is the
     bottom of #nosotros — so the horizon sits exactly where it did before. -->
<div class="sky-stage" id="skyStage">

  <div class="desert" id="desert" aria-hidden="true">
    <div class="desert-layer d-sky"   data-anchor="stage" data-parallax="0"></div>
    <div class="desert-layer d-stars" data-anchor="stage" data-parallax="0.45"></div>
    <!-- The moon keeps 80% of the scroll: it hangs in the sky the whole way down while
         sinking towards the mesas, which paint after it and hide it at the end. -->
    <div class="desert-layer d-sun"   data-anchor="stage" data-parallax="0.80"></div>
    <div class="desert-layer d-far"   data-parallax="0.13"  data-in="0"    data-span="0.62"></div>
    <div class="desert-layer d-mid"   data-parallax="0.09"  data-in="0.10" data-span="0.62"></div>
    <!-- The near dunes now rise BEFORE the mid-distance pair. Those two stand on the
         crest with their feet just behind it, and the dunes are what hides the cut: if the
         cacti grew first they would spend a moment rooted in open sky. Paint order is
         unchanged — the dunes still come after them in the DOM, which is what does the
         hiding. -->
    <div class="desert-layer d-near"  data-rise="slide" data-parallax="0"     data-in="0.20" data-span="0.34"></div>
    <div class="desert-layer d-c5 desert-cactus" data-parallax="0"     data-in="0.15" data-span="0.36"></div>
    <div class="desert-layer d-c4 desert-cactus" data-parallax="0"     data-in="0.19" data-span="0.36"></div>
    <div class="desert-layer d-c2 desert-cactus" data-parallax="-0.18" data-in="0.25" data-span="0.38"></div>
    <div class="desert-layer d-c1 desert-cactus" data-parallax="-0.15" data-in="0.34" data-span="0.36"></div>
    <div class="desert-layer d-c3 desert-cactus" data-parallax="-0.12" data-in="0.43" data-span="0.36"></div>
  </div>

  <header class="hero" id="top">
    <div class="hero-inner">
      <span class="hero-kicker">Café de especialidad · Antofagasta, Chile</span>
      <h1>Tostado al norte.<br><em>Hecho con carácter.</em></h1>
      <p class="hero-sub">Cafés de especialidad seleccionados por su origen y tostados en Antofagasta, donde el desierto imprime nuestra forma de entender el café.</p>
      <a href="#tueste" class="hero-cta">Descubrir nuestros cafés <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </header>

<section class="section-alt" id="nosotros">
  <!-- Desert sunset scene. Layers are background-images on divs, never inline SVG:
       the 11 source files reuse the same internal class names (.cls-1) and gradient
       ids, so inlining them would collide and break the gradients. -->
  <!-- data-parallax is lag, not depth: a positive value holds the layer back against the
       scroll so it reads as further away, and a negative one runs it ahead of the scroll
       so it reads as nearer. The stars therefore take the largest value and the near
       dunes sit at 0 — they are the ground line, and holding them still keeps the horizon
       welded to the table. The sky is exempt because a bare gradient shows no motion. -->
  <!-- data-in / data-span place each layer's entrance along the TERRAIN's own clock (0-1),
       which runs as the horizon crosses the lower three quarters of the screen — not along
       the section's scroll. See desert-scene.js. The scene builds back to front and the
       foreground cacti sprout at clearly separated moments rather than together.
       data-parallax is lag, not depth: positive holds a layer back against the scroll so
       it reads as further away, negative runs it ahead so it reads as nearer. The near
       dunes stay at 0 — they are the ground line, and holding them still keeps the
       horizon welded to the table. The sky is exempt; a bare gradient shows no motion. -->
  
  <div class="container">
    <div class="section-head reveal">
      <div class="eyebrow">Nuestro origen</div>
      <h2>Nacimos en el desierto más árido del mundo</h2>
      <p>Árido es un proyecto nuevo, nortino de principio a fin. Creemos que el café de especialidad no debería quedarse solo en el sur — por eso tostamos en el norte y hacemos llegar los granos de los campos de Colombia y Etiopía directamente a las familias de todo Chile.</p>
    </div>
    <div class="about-grid">
      <div class="about-copy reveal">
        <p>Cada bolsa de <strong>Árido</strong> nace de la selección cuidadosa de dos orígenes que representan lo mejor del café de especialidad: los valles cafeteros de <strong>Colombia</strong> y las tierras altas de <strong>Etiopía</strong>, cuna histórica del café.</p>
        <p>Un café de culto no se improvisa: se elige, se tuesta y se comparte con quienes saben esperar por una buena taza — en pleno desierto de Atacama.</p>
        <div class="stats-row">
          <div class="stat"><div class="num" data-count="2">0</div><div class="label">Orígenes de café<br>Colombia · Etiopía</div></div>
          <div class="stat"><div class="num" data-count="16">0</div><div class="label">Regiones de Chile<br>a las que llegamos</div></div>
        </div>
      </div>
      <div class="map-badge reveal-scale">
        <div class="eyebrow" style="margin-bottom:4px;">Llegamos a</div>
        <div class="region-list">
          <div class="region-item is-wide"><span class="pip"></span>Todo Chile</div>
          <div class="region-note">De Arica a Magallanes, despacho a domicilio.</div>
        </div>
      </div>
    </div>
  </div>
</section>
</div><!-- /sky-stage -->

<!-- ============================================================================
     EL TUESTE — experiencia interactiva de producto.
     Dos estados dentro de la misma sección:
       1. .roast-stage    -> narrativa del tueste (estado inicial)
       2. .product-stage  -> exploración del producto (al abrir "Elige tu café")
     Los datos de los tres cafés viven en roast-experience.js, en la constante
     COFFEES. Nada de esta información se escribe a mano en el HTML.
     ============================================================================ -->
<section id="tueste">

  <!-- Pestaña flotante anclada al borde izquierdo. Sticky dentro de un carril de
       ancho cero, para que acompañe el scroll sin ocupar espacio en el layout. -->


  <div class="container">

    <!-- ---------- ESTADO 1: NARRATIVA DEL TUESTE ---------- -->
    <div class="roast-stage" id="roastStage">
      <div class="section-head reveal">
        <div class="eyebrow">El tueste</div>
        <h2>Tostado aquí, no heredado</h2>
        <p>Cada origen se tuesta en Antofagasta buscando el punto en que el grano muestra lo suyo sin que el tueste se imponga por encima.</p>
      </div>

      <!-- Secuencia del tueste. El color de cada grano avanza de verde a tostado;
           es toda la narrativa que hace falta, sin párrafos de relleno. -->
      <ol class="roast-phases reveal" aria-label="Fases del tueste">
        <li style="--phase:#93A860; --shade:0"><span class="phase-bean"></span><span class="phase-name">Grano verde</span></li>
        <li style="--phase:#CBA95F; --shade:0"><span class="phase-bean"></span><span class="phase-name">Desarrollo</span></li>
        <li style="--phase:#C07A31; --shade:.06"><span class="phase-bean"></span><span class="phase-name">Primer crack</span></li>
        <li style="--phase:#9A4F1D; --shade:.18"><span class="phase-bean"></span><span class="phase-name">Aroma</span></li>
        <li style="--phase:#63321A; --shade:.32"><span class="phase-bean"></span><span class="phase-name">Grano tostado</span></li>
        <li style="--phase:#3F1E10; --shade:.48"><span class="phase-bean"></span><span class="phase-name">Café Árido</span></li>
      </ol>

      <p class="roast-line reveal">El tueste revela lo que el origen ya contiene.</p>

      <div class="roast-grid">
        <div class="roast-step reveal">
          <span class="roast-num">01</span>
          <h3>La tostadora</h3>
          <p class="desc">[MODELO Y CAPACIDAD DE LA TOSTADORA — PENDIENTE]</p>
        </div>
        <div class="roast-step reveal">
          <span class="roast-num">02</span>
          <h3>El perfil</h3>
          <p class="desc">[PERFIL DE TUESTE POR ORIGEN — PENDIENTE]</p>
        </div>
        <div class="roast-step reveal">
          <span class="roast-num">03</span>
          <h3>Los lotes</h3>
          <p class="desc">[FRECUENCIA DE TUESTE Y TAMAÑO DE LOTE — PENDIENTE]</p>
        </div>
      </div>
      <p class="cafe-note reveal">* Estamos documentando el proceso. Escríbenos por WhatsApp si quieres conocer los detalles del tueste de un lote concreto.</p>
    </div>

    <!-- ---------- ESTADO 2: PRODUCTO ---------- -->
    <div class="product-stage" id="productStage" hidden>

      <!-- Fondo del café seleccionado. Dos capas para poder hacer crossfade entre
           productos sin que ninguna llegue a desaparecer del todo. -->
      <div class="prod-bg" aria-hidden="true">
        <div class="prod-bg-layer" data-slot="a"></div>
        <div class="prod-bg-layer" data-slot="b"></div>
      </div>

      <!-- Columna editorial -->
      <div class="prod-copy" id="prodCopy">
        <button type="button" class="prod-back" id="prodBack">
          <span aria-hidden="true">&#8592;</span> Volver al tueste
        </button>
        <span class="prod-origin" id="prodOrigin"></span>
        <h3 class="prod-name" id="prodName"></h3>
        <p class="prod-subtitle" id="prodSubtitle"></p>
        <p class="prod-desc" id="prodDesc"></p>

        <ul class="prod-notes" id="prodNotes" aria-label="Notas de cata"></ul>

        <div class="prod-meters" id="prodMeters"></div>

        <dl class="prod-facts" id="prodFacts"></dl>
      </div>

      <!-- Fondo a sangre completa. Va suelto en el escenario y no dentro de .prod-art,
           porque con `scene` esa caja se oculta entera (la bolsa ya viene en el render). -->
      <div class="prod-scene" id="prodScene" aria-hidden="true" hidden></div>

      <!-- Respaldo para los cafés sin render: bolsa vectorial sobre los granos. -->
      <div class="prod-art">
        <canvas class="prod-beans" id="prodBeans" aria-hidden="true"></canvas>
        <div class="prod-pack" id="prodPack"></div>
      </div>

    </div>
  </div>
</section>

<section class="section-alt" id="contacto">
  <canvas class="sand-layer" id="sandContacto" aria-hidden="true"></canvas>
  <canvas class="sand-layer sand-trail" id="sandContactoTrail" aria-hidden="true"></canvas>
  <!-- Shoreline band across the foot of the section: the sea lies past the bottom edge
       and washes up over the sand that is already there. -->
  <canvas class="shore-layer" id="shoreCanvas" aria-hidden="true"></canvas>
  <div class="container">
    <div class="section-head reveal">
      <div class="eyebrow">Hablemos</div>
      <h2>Un café de culto empieza con un mensaje</h2>
      <p>Escríbenos para pedidos, disponibilidad o simplemente para conversar de café.</p>
    </div>
    <div class="contact-grid">
      <div class="contact-list reveal">
        <a class="contact-item" href="https://wa.me/56972497925" target="_blank" rel="noopener">
          <span class="contact-icon">📞</span>
          <div><div class="label">Teléfono / WhatsApp</div><div class="value">+56 9 7249 7925</div></div>
        </a>
        <a class="contact-item" href="mailto:david@aridocafe.cl">
          <span class="contact-icon">✉️</span>
          <div><div class="label">Email</div><div class="value">david@aridocafe.cl</div></div>
        </a>
        <a class="contact-item" href="https://www.instagram.com/cafearido/" target="_blank" rel="noopener">
          <span class="contact-icon">📷</span>
          <div><div class="label">Instagram</div><div class="value">@cafearido</div></div>
        </a>
        <div class="contact-item pending">
          <span class="contact-icon">📍</span>
          <div><div class="label">Zona de despacho</div><div class="value">[DIRECCIÓN / ZONA DE DESPACHO PENDIENTE]</div></div>
        </div>
        <div class="contact-item pending">
          <span class="contact-icon">🕐</span>
          <div><div class="label">Horario</div><div class="value">[HORARIO DE ATENCIÓN PENDIENTE]</div></div>
        </div>
      </div>

      <form class="contact-form reveal" id="contactForm">
        <div class="form-row">
          <label for="name">Nombre</label>
          <input type="text" id="name" name="name" required>
        </div>
        <div class="form-row">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required>
        </div>
        <div class="form-row">
          <label for="message">Mensaje</label>
          <textarea id="message" name="message" rows="4" required></textarea>
        </div>
        <button type="submit" class="btn btn-accent">Enviar mensaje</button>
      </form>
    </div>
  </div>
</section>


<!-- La pestaña, el velo y el cajón viven fuera de #tueste y cuelgan directamente del
     body. Dentro de la sección no valen: #tueste lleva overflow-x:clip y hay motores que
     toman ese ancestro como bloque contenedor de los position:fixed, con lo que la
     pestaña dejaba de estar fija y se arrastraba con el scroll. Fuera de ahí no hay
     ningún ancestro que pueda romperlo.
     Su estado lo marcan clases en el <body> (t-near, t-open, t-sheet), no en la sección,
     porque ya no son descendientes suyos. -->
  <div class="pick-dock" aria-hidden="false">
    <button type="button" class="pick-tab" id="pickTab"
            aria-expanded="false" aria-controls="pickPanel">
      <span class="pick-bean" aria-hidden="true">
        <!-- Dos mitades partidas por el surco: al abrir el panel se separan, como un
             grano que se abre. Antes era una elipse entera con el surco pintado encima. -->
        <svg viewBox="0 0 34 52" fill="none">
          <path class="bean-half bean-l"
                d="M17 3C12 12 12 17 17 26C22 35 22 40 17 49A16 25 0 0 1 17 3Z"
                fill="currentColor"/>
          <path class="bean-half bean-r"
                d="M17 3C12 12 12 17 17 26C22 35 22 40 17 49A16 25 0 0 0 17 3Z"
                fill="currentColor"/>
        </svg>
      </span>
      <span class="pick-label">Elige tu café</span>
      <span class="pick-chevron" aria-hidden="true">
        <svg viewBox="0 0 12 20" fill="none">
          <path d="M2 2l8 8-8 8" stroke="currentColor" stroke-width="2.2"
                stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </button>
  </div>
  <!-- Velo: solo activo en móvil, donde el panel es una hoja inferior -->
  <div class="pick-scrim" id="pickScrim" hidden></div>

  <!-- Menú lateral de productos. La lista la construye roast-experience.js -->
  <div class="pick-panel" id="pickPanel" role="group" aria-label="Elige tu café" hidden>
    <div class="pick-panel-head">
      <span class="eyebrow">Nuestros cafés</span>
    </div>
    <ul class="pick-list" id="pickList"></ul>
    <p class="pick-foot">Escríbenos por WhatsApp para conocer disponibilidad.</p>
  </div>

<footer>
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="brand-mark"><img src="assets/logo-emblem.png" alt="Árido"></span>
      <span class="footer-copy">© <span id="year"></span> Árido Coffee Roasters. Un café de culto.</span>
    </div>
    <div class="footer-social">
      <a href="https://www.instagram.com/cafearido/" target="_blank" rel="noopener" aria-label="Instagram">📷</a>
      <a href="mailto:david@aridocafe.cl" aria-label="Email">✉️</a>
      <a href="https://wa.me/56972497925" target="_blank" rel="noopener" aria-label="WhatsApp">📞</a>
    </div>
  </div>
</footer>

<script src="main.js?v=202609102104"></script>

<script src="sand-effect.js?v=202609102104"></script>
<script src="desert-scene.js?v=202609102104"></script>
<script src="shore.js?v=202609102104"></script>
<script src="roast-experience.js?v=202609102104"></script>

</body>
</html>
