  :root{
    --bg: #FFFFFF;
    --bg-alt: #EDEDEC;
    --ink: #141414;
    --ink-dim: #5c5c5c;
    --card: #FFFFFF;
    --card-line: rgba(0,0,0,0.12);
    --accent: #E4611E;
    --accent-deep: #A8460F;
    --accent-light: #F2A671;
    --accent-soft: #EE8142;
    --blue: #6FB8D6;
    --blue-deep: #2E6E88;
    --blue-light: #B9E1F0;
    --line: rgba(0,0,0,0.14);
    --serif: 'Merriweather', serif;
    --sans: 'Montserrat', sans-serif;
  }

  *{ margin:0; padding:0; box-sizing:border-box; }

  html{ scroll-behavior:smooth; }

  @media (prefers-reduced-motion: reduce){
    html{ scroll-behavior:auto; }
    *{ animation-duration:0.01ms !important; transition-duration:0.01ms !important; }
  }

  body{
    background:var(--bg);
    color:var(--ink);
    font-family:var(--sans);
    line-height:1.6;
    /* Sin overflow-x:hidden. Estaba de red de seguridad, pero es otro de los ancestros
       que pueden robarle el bloque contenedor a un position:fixed segun el motor, y la
       pestaña cuelga ahora justo del body. Comprobado que sobra: con overflow visible, el
       scrollWidth del documento sigue siendo igual al ancho de ventana en 1920, 1440,
       1180, 820 y 390 — lo unico que asoma es el cajon, que al ser fixed no lo ensancha.
       Lo que de verdad recorta la escena a sangre de #tueste es su overflow-x:clip. */
    -webkit-font-smoothing:antialiased;
  }

  ::selection{ background:var(--accent-soft); color:#fff; }

  ::-webkit-scrollbar{ width:10px; }
  ::-webkit-scrollbar-track{ background:var(--bg-alt); }
  ::-webkit-scrollbar-thumb{ background:var(--accent); border-radius:10px; }
  ::-webkit-scrollbar-thumb:hover{ background:var(--accent-deep); }

  a{ color:inherit; text-decoration:none; }
  img{ max-width:100%; display:block; }

  /* El contenido arranca mas a la izquierda: la caja es mas ancha y el margen lateral
     mas corto, asi que en pantallas grandes el texto deja de quedar tan centrado. */
  .container{
    max-width:1340px;
    margin:0 auto;
    padding:0 clamp(18px, 3.2vw, 34px);
  }

  .eyebrow{
    display:inline-flex;
    align-items:center;
    gap:10px;
    font-family:var(--sans);
    font-size:0.78rem;
    letter-spacing:0.22em;
    text-transform:uppercase;
    color:var(--accent-deep);
    font-weight:700;
    margin-bottom:18px;
  }
  .eyebrow::before{
    content:'';
    width:26px; height:1px;
    background:var(--accent);
    display:inline-block;
  }

  h1,h2,h3{ font-family:var(--serif); font-weight:600; line-height:1.05; color:var(--ink); }

  /* dot / grain texture */
  .grain{
    position:absolute; inset:0;
    background-image: radial-gradient(var(--accent) 1px, transparent 1.4px);
    background-size: 22px 22px;
    opacity:0.09;
    pointer-events:none;
  }

  /* ---------- NAV ---------- */
  /* Two states. At the top the bar floats bare over the dusk sky with cream type; once
     scrolled it condenses into the white pill, which is what keeps it legible over the
     pale sections further down. It hides on the way down and returns on the way up. */
  nav{
    position:fixed; top:0; left:0; right:0;
    z-index:100;
    display:flex; justify-content:center;
    padding:clamp(18px, 2.2vw, 30px) clamp(16px, 2.4vw, 34px) 0;
    transition:padding-top 0.4s ease, transform 0.4s ease;
    pointer-events:none;
  }
  /* -140% and not -100%: the shadow has to clear the edge too. */
  nav.nav-hidden{ transform:translateY(-140%); }
  nav.nav-scrolled{ padding-top:clamp(10px, 1.4vw, 16px); }

  /* Three tracks, not flexbox: the outer two share the leftover space equally, so the
     links stay optically centred however wide the brand or the button turn out to be. */
  .nav-pill{
    display:grid;
    grid-template-columns:1fr auto 1fr;
    align-items:center; gap:24px;
    width:100%; max-width:1200px;
    pointer-events:auto;
    padding:10px 12px 10px 20px;
    border-radius:100px;
    border:1px solid transparent;
    background:transparent;
    transition:background 0.35s ease, border-color 0.35s ease,
               box-shadow 0.35s ease, max-width 0.35s ease;
  }
  nav.nav-scrolled .nav-pill{
    max-width:1080px;
    background:rgba(255,255,255,0.88);
    border-color:var(--card-line);
    backdrop-filter:blur(16px);
    -webkit-backdrop-filter:blur(16px);
    box-shadow:0 14px 34px rgba(0,0,0,0.14);
  }

  /* The two logo files are drawn in cream (#fefcf6), which is what the dusk sky wants.
     The scrolled state inverts them to black against the white pill. */
  .nav-brand{ display:flex; align-items:center; justify-self:start; }
  .nav-brand-icon{
    width:26px; height:auto; flex-shrink:0;
    transition:filter 0.35s ease, opacity 0.35s ease;
  }
  .nav-brand-word{
    height:15px; width:auto; margin-left:11px; flex-shrink:0;
    transition:filter 0.35s ease, opacity 0.35s ease;
  }
  nav.nav-scrolled .nav-brand-icon,
  nav.nav-scrolled .nav-brand-word{
    filter:brightness(0) saturate(100%);
    opacity:0.88;
  }

  .brand-mark{
    width:38px; height:38px; border-radius:50%;
    overflow:hidden;
    background:var(--bg-alt);
    flex-shrink:0;
    box-shadow:0 0 0 1px var(--line);
  }
  .brand-mark img{ width:100%; height:100%; object-fit:cover; transform:scale(1.32); }

  .nav-links{
    display:flex; align-items:center; gap:clamp(20px, 2.4vw, 34px);
    justify-self:center;
    font-size:0.88rem; font-weight:600;
  }
  .nav-links a{
    position:relative; padding:4px 0;
    color:rgba(255,246,235,0.82);
    white-space:nowrap;
    transition:color 0.3s ease;
  }
  .nav-links a::after{
    content:''; position:absolute; left:0; bottom:-2px;
    width:0; height:1px; background:var(--accent-light);
    transition:width 0.3s ease;
  }
  .nav-links a:hover{ color:#FFF8EE; }
  .nav-links a:hover::after{ width:100%; }
  nav.nav-scrolled .nav-links a{ color:var(--ink-dim); }
  nav.nav-scrolled .nav-links a::after{ background:var(--accent); }
  nav.nav-scrolled .nav-links a:hover{ color:var(--ink); }

  .nav-cta{ justify-self:end; padding:11px 24px; font-size:0.82rem; }

  .btn{
    display:inline-flex; align-items:center; justify-content:center; gap:8px;
    padding:13px 28px;
    border-radius:100px;
    font-weight:700; font-size:0.88rem;
    letter-spacing:0.03em;
    border:1px solid transparent;
    cursor:pointer;
    transition:transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease, color 0.3s ease;
    white-space:nowrap;
  }
  .btn-accent{
    background:linear-gradient(135deg, var(--accent-light), var(--accent));
    color:#141414;
  }
  .btn-accent:hover{ transform:translateY(-2px); box-shadow:0 12px 26px rgba(228,97,30,0.35); }
  .btn-ghost{
    border-color:var(--line); color:var(--ink);
    background:transparent;
  }
  .btn-ghost:hover{ border-color:var(--accent); color:var(--accent-deep); }

  .burger{
    display:none;
    justify-self:end;
    width:38px; height:38px;
    border:1px solid rgba(255,255,255,0.34);
    border-radius:50%;
    background:transparent;
    color:#FFF8EE;
    transition:border-color 0.35s ease, color 0.35s ease;
    align-items:center; justify-content:center;
    cursor:pointer;
    flex-shrink:0;
  }
  nav.nav-scrolled .burger{ border-color:var(--line); color:var(--ink); }

  /* ---------- SKY STAGE ---------- */
  /* Wraps the hero and "Nuestro origen" so one continuous sky runs behind both. The
     desert scene is positioned against THIS box, not against the section: that is what
     lets the moon sit up in the hero while the mesas still land on the bottom edge of
     #nosotros, exactly where the horizon was before. */
  .sky-stage{
    position:relative;
    /* Distance from the stage bottom up to the scene's ground line. Lives here now that
       the scene is a child of the stage rather than of the section. */
    --desert-floor:0px;
    /* Only shows if the scene fails to paint; matched to the top of the sky gradient so a
       failure degrades to deep dusk instead of flashing white behind cream type. */
    background:#460c6e;
  }

  /* ---------- HERO ---------- */
  .hero{
    position:relative;
    /* Over .desert, which sits at z-index 0. Without this the whole hero would paint
       underneath the sky — non-positioned content loses to a positioned sibling. */
    z-index:1;
    min-height:100vh;
    min-height:100svh;
    display:flex; align-items:center; justify-content:center;
    text-align:center;
    padding:clamp(130px, 18vh, 190px) clamp(20px, 5vw, 48px) clamp(70px, 11vh, 120px);
  }
  /* A soft pool of shade under the copy. The star field runs right through this part of
     the sky, and cream type set over loose white dots reads as speckled rather than
     clean — this settles the background without showing an edge anywhere. */
  .hero::before{
    content:'';
    position:absolute;
    left:50%; top:50%;
    /* Never wider than the hero itself: at 128% the centred pool hung 78px off each
       side and pushed the document's scroll width past the viewport. */
    width:min(1180px, 100%); height:min(760px, 96%);
    transform:translate(-50%, -50%);
    background:radial-gradient(ellipse at center,
                 rgba(38,6,58,0.66) 0%,
                 rgba(38,6,58,0.44) 45%,
                 rgba(38,6,58,0) 74%);
    pointer-events:none;
    z-index:-1;
  }
  .hero-inner{ position:relative; max-width:780px; }
  .hero-kicker{
    display:inline-block;
    font-family:var(--sans);
    font-size:0.7rem; font-weight:700;
    letter-spacing:0.24em; text-transform:uppercase;
    color:rgba(255,246,235,0.92);
    padding:9px 20px;
    border-radius:100px;
    background:rgba(255,255,255,0.10);
    border:1px solid rgba(255,255,255,0.22);
    backdrop-filter:blur(10px);
    -webkit-backdrop-filter:blur(10px);
    margin-bottom:clamp(22px, 3.4vh, 34px);
  }
  .hero h1{
    font-size:clamp(2.5rem, 6.6vw, 4.8rem);
    line-height:1.06;
    color:#FFF8EE;
    text-shadow:0 2px 26px rgba(28,4,40,0.4);
  }
  .hero h1 em{ font-style:italic; color:var(--accent-light); }
  .hero-sub{
    margin:clamp(20px, 3vh, 30px) auto 0;
    max-width:580px;
    font-size:clamp(0.98rem, 1.35vw, 1.1rem);
    line-height:1.75;
    color:rgba(255,246,235,0.85);
  }
  .hero-cta{
    display:inline-flex; align-items:center; gap:12px;
    margin-top:clamp(28px, 4.2vh, 44px);
    padding:16px 34px;
    border-radius:100px;
    background:linear-gradient(135deg, var(--accent-light), var(--accent));
    color:#141414;
    font-family:var(--sans); font-weight:700;
    font-size:0.9rem; letter-spacing:0.03em;
    box-shadow:0 14px 34px rgba(0,0,0,0.3);
    transition:transform 0.3s ease, box-shadow 0.3s ease;
  }
  .hero-cta:hover{ transform:translateY(-2px); box-shadow:0 18px 40px rgba(228,97,30,0.42); }
  .hero-cta .arrow{ transition:transform 0.3s ease; }
  .hero-cta:hover .arrow{ transform:translateX(5px); }

  /* ---------- EL TUESTE ---------- */
  .roast-grid{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:28px;
  }
  .roast-step{
    padding:34px 30px 32px;
    border:1px solid var(--card-line);
    border-radius:20px;
    background:var(--card);
  }
  .roast-num{
    display:block;
    font-family:var(--serif);
    font-size:1.5rem;
    color:var(--accent);
    margin-bottom:14px;
  }
  .roast-step h3{ font-size:1.25rem; margin-bottom:10px; }
  .roast-step .desc{ color:var(--ink-dim); font-size:0.95rem; line-height:1.7; }

  /* ---------- EL TUESTE — experiencia de producto ---------- */
  /* Todo lo de este bloque cuelga de #tueste. Nada aquí toca otras secciones. */

  #tueste{
    position:relative;
    /* Igual al padding vertical de section; lo usa .prod-scene para desbordarlo. */
    --sec-pad:120px;
    /* `clip` y no `hidden`: hidden convierte la sección en contenedor de scroll, y eso
       deja sin efecto el position:sticky de la pestaña — se quedaba clavada abajo del
       todo en vez de acompañar el scroll. `clip` recorta igual sin crear scrollport. */
    overflow-x:clip;
  }
  /* Los dos estados se apilan en la misma celda de grid en vez de sacar uno del flujo.
     Con position:absolute la sección encogía 630px al abrir el panel y la página pegaba
     un salto bajo el cursor; apilados, la altura la sigue marcando la narrativa y no se
     mueve nada. */
  #tueste .container{
    position:relative; z-index:1; display:grid;
    /* Chrome reajusta el scroll cuando cambia el contenido de la página para "mantener
       la vista": al intercambiar narrativa por producto eso movía la página ~200px bajo
       el cursor sin que la sección hubiera cambiado de alto. */
    overflow-anchor:none;
  }
  .roast-stage, .product-stage{ grid-area:1 / 1; }

  /* --- narrativa del tueste (estado inicial) --- */
  .roast-phases{
    list-style:none;
    display:grid;
    grid-template-columns:repeat(6, 1fr);
    gap:14px;
    margin:8px 0 40px;
    counter-reset:phase;
  }
  .roast-phases li{
    display:flex; flex-direction:column; align-items:center; gap:12px;
    text-align:center;
    position:relative;
  }
  /* Hilo que une las fases: se dibuja hacia la siguiente, así que la última no lo lleva. */
  .roast-phases li::after{
    content:'';
    position:absolute; top:17px; left:calc(50% + 32px); right:calc(-50% + 32px);
    height:1px; background:var(--line);
  }
  .roast-phases li:last-child::after{ display:none; }
  /* El grano es el render 3D de la web, no un dibujo: se pinta la foto y encima dos
     capas enmascaradas con su propia silueta. La de color aporta tono (mix-blend-mode
     color conserva la luz del render) y la de sombra oscurece segun avanza el tueste.
     isolation:isolate encierra la mezcla dentro del grano; sin ella se mezclaria con la
     pagina entera. */
  .phase-bean{
    position:relative;
    isolation:isolate;
    width:46px; height:34px;
    flex-shrink:0;
    background-image:url('assets/grano.webp');
    background-size:contain; background-repeat:no-repeat; background-position:center;
    filter:drop-shadow(0 3px 5px rgba(0,0,0,0.18));
  }
  .phase-bean::before,
  .phase-bean::after{
    content:''; position:absolute; inset:0;
    -webkit-mask-image:url('assets/grano.webp'); mask-image:url('assets/grano.webp');
    -webkit-mask-size:contain; mask-size:contain;
    -webkit-mask-repeat:no-repeat; mask-repeat:no-repeat;
    -webkit-mask-position:center; mask-position:center;
  }
  .phase-bean::before{ background:var(--phase); mix-blend-mode:color; }
  .phase-bean::after{ background:#000; opacity:var(--shade, 0); mix-blend-mode:multiply; }

  .roast-phases .phase-name{
    font-size:0.68rem; letter-spacing:0.14em; text-transform:uppercase;
    font-weight:700; color:var(--ink-dim);
    line-height:1.35;
  }
  .roast-line{
    font-family:var(--serif); font-style:italic;
    font-size:clamp(1.2rem, 2.4vw, 1.7rem);
    color:var(--ink);
    max-width:560px;
    margin:0 0 52px;
  }

  /* --- pestaña "Elige tu café" --- */
  /* Carril de ancho cero pegado al borde izquierdo: la pestaña va sticky dentro, de modo
     que acompaña el scroll sin ocupar sitio en el layout ni empujar el contenido. */
  /* Envoltorio sin geometria: la pestaña se posiciona sola con position:fixed. */
  .pick-dock{ position:static; }
  .pick-tab{
    z-index:91;
    --pick-crease:rgba(255,255,255,0.28);
    /* fixed y no sticky: sticky arranca en su sitio natural y solo se engancha cuando el
       scroll lo alcanza, asi que al entrar en la seccion todavia subia con la pagina.
       Fijo al viewport no se mueve nunca. Se muestra solo mientras la seccion esta
       cerca — lo gobierna la clase is-near desde roast-experience.js. */
    position:fixed;
    /* Por que borde se ancla. Lo lee el JS: getComputedStyle().top devuelve pixeles
       aunque el CSS diga `auto`, asi que desde JS no hay forma de saberlo si no se
       declara aqui. */
    --tab-anchor:top;
    /* En pixeles, NO en vh. `13vh` se recalcula cada vez que cambia la altura de la
       ventana, y en los navegadores moviles esa altura cambia sola al hacer scroll porque
       la barra de direcciones se pliega y se despliega. El resultado es un elemento fijo
       que se desliza mientras scrolleas — exactamente lo que se veia. En escritorio el vh
       es constante, por eso las pruebas en ventana fija nunca lo reproducian.
       Un valor en px no depende de nada y no se puede mover. */
    top:126px;
    right:0;
    pointer-events:auto;
    opacity:0;
    visibility:hidden;
    display:flex; align-items:center; gap:12px;
    /* En espejo: el grano queda hacia dentro y el chevron hacia el borde. */
    flex-direction:row-reverse;
    padding:14px 16px 14px 20px;
    /* El desplazamiento horizontal va por variable y no escrito en cada regla: asi el
       deslizamiento al abrir el panel y el del hover no se pisan entre si. La correccion
       vertical del ancla NO va aqui — usa `top`, que no esta en la transicion. */
    --tab-x:0px;
    transform:translate3d(var(--tab-x), 0, 0);
    transition:transform .45s cubic-bezier(0.22,1,0.36,1),
               box-shadow .45s cubic-bezier(0.22,1,0.36,1),
               gap .5s cubic-bezier(0.22,1,0.36,1),
               background .35s ease;
    border:1px solid var(--card-line);
    border-right:none;
    border-radius:100px 0 0 100px;
    background:var(--card);
    box-shadow:0 16px 40px rgba(0,0,0,0.14);
    cursor:pointer;
    color:var(--ink);
    font-family:var(--sans);
  }
  body.t-open .pick-tab{ gap:9px; }
  .pick-bean{
    display:block; width:19px; height:29px;
    color:#2A1B12;                       /* el grano; el surco usa --pick-crease */
    transition:transform .5s cubic-bezier(0.22,1,0.36,1);
  }
  .pick-bean svg{ width:100%; height:100%; display:block; }
  .pick-label{
    font-size:0.74rem; font-weight:800;
    letter-spacing:0.2em; text-transform:uppercase;
    white-space:nowrap;
    max-width:14ch; opacity:1;
    transition:max-width .5s cubic-bezier(0.22,1,0.36,1), opacity .3s ease;
  }
  /* Con el panel abierto la etiqueta ya no dice nada que no se vea, y ocupando 140px se
     comía la columna editorial. Se pliega y la pestaña queda como asa del panel. */
  /* También plegada con el producto a la vista, no solo con el panel abierto: desplegada
     asoma hasta unos 190px desde el borde y caía justo encima de la descripción, que
     ahora empieza en la misma vertical que el resto de los textos de la web. */
  body.t-open .pick-label,
  body.t-show .pick-label{ max-width:0; opacity:0; overflow:hidden; }
  body.t-show .pick-tab{ gap:9px; }
  .pick-chevron{
    display:block; width:9px; height:15px; color:var(--accent);
    transition:transform .5s cubic-bezier(0.22,1,0.36,1);
  }
  .pick-chevron svg{ width:100%; height:100%; display:block; }
  body.t-near .pick-tab{ opacity:1; visibility:visible; }
  .pick-tab:hover{
    --tab-x:-5px;
    box-shadow:0 20px 46px rgba(0,0,0,0.18);
  }
  .pick-tab:hover .pick-bean{ transform:rotate(-9deg) scale(1.06); }
  .pick-tab:focus-visible{
    outline:2px solid var(--accent);
    outline-offset:3px;
  }
  /* Abierto: la pestaña se corre hasta el canto del panel y se queda pegada a el, en vez
     de quedar encima. El grano, ademas, se parte en dos. */
  .pick-chevron{ transform:rotate(180deg); }
  body.t-open .pick-chevron{ transform:rotate(0deg); }
  body.t-open .pick-tab{
    --tab-x:calc(-1 * var(--panel-w));
    border-radius:16px 0 0 16px;
    box-shadow:0 20px 46px rgba(0,0,0,0.20);
  }
  body.t-open .pick-tab:hover{ --tab-x:calc(-1 * var(--panel-w) - 4px); }

  .bean-half{
    transform-origin:17px 26px;
    transition:transform .55s cubic-bezier(0.22,1,0.36,1);
  }
  body.t-open .bean-l{ transform:translateX(-3.4px) rotate(-9deg); }
  body.t-open .bean-r{ transform:translateX(3.4px)  rotate(9deg); }

  /* --- panel de productos --- */
  :root{ --panel-w:clamp(280px, 25vw, 360px); }
  /* A la derecha, y se despliega desde ese borde. Cuelga del body, no de #tueste. */
  .pick-panel{
    /* fixed, igual que la pestaña. Absoluto viajaba con la seccion mientras la pestaña se
       quedaba clavada al viewport, asi que se desalineaban en cuanto habia scroll. Fijos
       los dos, van siempre juntos y el panel se comporta como un cajon. */
    position:fixed;
    right:0; top:0; bottom:0;
    width:var(--panel-w);
    max-width:34vw;
    z-index:90;
    pointer-events:auto;
    display:flex; flex-direction:column;
    padding:clamp(92px, 12vh, 130px) clamp(20px, 2vw, 28px) clamp(28px, 3vw, 40px);
    /* Tierra de desierto en lugar del blanco de tarjeta. */
    background:linear-gradient(178deg, #E8D8C0 0%, #D9C2A2 55%, #CDB18E 100%);
    border-left:1px solid rgba(90,58,30,0.22);
    box-shadow:-26px 0 60px rgba(60,36,16,0.18);
    transform:translateX(101%);
    transition:transform .62s cubic-bezier(0.22,1,0.36,1);
    overflow-y:auto;
  }
  body.t-open .pick-panel{ transform:none; }
  .pick-panel-head{
    display:flex; align-items:flex-start;
    gap:12px; margin-bottom:22px;
  }
  .pick-panel-head .eyebrow{ margin-bottom:0; }
  .pick-list{ list-style:none; display:flex; flex-direction:column; gap:10px; }
  .pick-item{
    width:100%;
    display:grid; grid-template-columns:46px 1fr 12px;
    align-items:center; gap:14px;
    padding:14px 14px 14px 12px;
    border:1px solid transparent;
    border-radius:14px;
    background:transparent;
    cursor:pointer; text-align:left;
    font-family:var(--sans); color:var(--ink);
    transition:background .3s ease, border-color .3s ease, transform .3s cubic-bezier(0.22,1,0.36,1);
  }
  .pick-item:hover{ background:rgba(255,252,244,0.55); transform:translateX(-3px); }
  .pick-item:focus-visible{ outline:2px solid var(--accent); outline-offset:2px; }
  .pick-item.is-current{
    background:rgba(255,252,244,0.72);
    border-color:rgba(90,58,30,0.28);
  }
  .pick-item.is-current .pick-arrow{ color:var(--accent); transform:translateX(2px); }
  .pick-thumb{
    width:46px; height:56px;
    display:flex; align-items:flex-end; justify-content:center;
    overflow:hidden;
  }
  .pick-thumb svg, .pick-thumb img{ width:100%; height:auto; display:block; }
  .pick-text{ display:flex; flex-direction:column; gap:3px; min-width:0; }
  .pick-name{
    font-family:var(--serif); font-size:1.05rem; font-weight:600;
    line-height:1.2;
  }
  .pick-sub{
    font-size:0.72rem; color:#6B4A2A; line-height:1.4;
  }
  .pick-arrow{
    width:9px; height:15px; color:#8A6234;
    transition:transform .3s ease, color .3s ease;
  }
  .pick-arrow svg{ width:100%; height:100%; display:block; }
  .pick-foot{
    margin-top:auto; padding-top:22px;
    font-size:0.74rem; color:#6B4A2A; line-height:1.6;
  }

  .pick-scrim{
    position:fixed; inset:0; z-index:89;
    background:rgba(20,16,12,0.5);
    opacity:0; transition:opacity .5s ease;
  }
  body.t-open .pick-scrim{ opacity:1; }

  /* --- composición de producto --- */
  /* El bloque narrativo no se destruye: se atenúa y se aparta, para poder volver a él
     al cerrar el panel sin reconstruir nada. */
  .roast-stage{
    transition:opacity .5s ease, transform .62s cubic-bezier(0.22,1,0.36,1);
  }
  #tueste.is-showing .roast-stage{
    opacity:0; transform:translateY(-18px);
    pointer-events:none;
  }

  .product-stage{
    --accent:#B4712F;
    position:relative;
    display:grid;
    grid-template-columns:minmax(0, 1fr) minmax(0, 0.9fr);
    align-items:center;
    align-content:center;
    gap:clamp(30px, 5vw, 70px);
    /* Sin sangria: con el panel a la derecha el texto ya no queda nunca debajo de el. */
    opacity:0; transform:translateY(22px);
    pointer-events:none;
    /* visibility y no el atributo `hidden`: hidden no hacía nada aquí, porque la regla
       .product-stage{display:grid} gana al [hidden]{display:none} del navegador. La ficha
       seguía en el flujo Y sus botones seguían siendo alcanzables con el tabulador
       estando invisible. visibility:hidden sí los saca del recorrido de teclado, y al
       conservar el hueco la sección nunca cambia de alto al abrir o cerrar.
       El retardo en visibility deja que termine el fundido antes de desaparecer. */
    visibility:hidden;
    transition:opacity .55s ease .12s,
               transform .62s cubic-bezier(0.22,1,0.36,1) .12s,
               visibility 0s linear .7s;
  }
  #tueste.is-showing .product-stage{
    opacity:1; transform:none; pointer-events:auto; visibility:visible;
    transition:opacity .55s ease .12s,
               transform .62s cubic-bezier(0.22,1,0.36,1) .12s,
               visibility 0s;
  }
  /* Sin JS la ficha no debe aparecer nunca: el script quita el atributo al arrancar. */
  #tueste .product-stage[hidden]{ display:none; }

  .prod-bg{ position:absolute; inset:-40px -30vw -40px -30vw; z-index:0; pointer-events:none; }
  .prod-bg-layer{
    position:absolute; inset:0;
    background-size:cover; background-position:center;
    opacity:0; transition:opacity .6s ease;
  }
  .prod-bg-layer.is-on{ opacity:1; }

  .prod-copy{
    position:relative; z-index:2;
    max-width:520px;
    transition:opacity .22s ease, transform .22s ease;
  }
  .prod-copy.is-swapping{ opacity:0; transform:translateY(10px); }

  /* Salida explicita del modo producto: sin esto, cerrar el panel en movil dejaba al
     visitante en la ficha sin manera evidente de volver a la narrativa. */
  .prod-back{
    /* width:max-content y no inline-flex: como inline compartía línea con el "ORIGEN ·"
       que va justo detrás, y en móvil los dos se pisaban. */
    display:flex; width:max-content; align-items:center; gap:8px;
    margin-bottom:20px; padding:8px 16px 8px 12px;
    border:1px solid var(--card-line); border-radius:100px;
    background:transparent; cursor:pointer;
    font-family:var(--sans); font-size:0.68rem; font-weight:700;
    letter-spacing:0.14em; text-transform:uppercase; color:var(--ink-dim);
    transition:border-color .25s ease, color .25s ease, transform .25s ease;
  }
  .prod-back:hover{ border-color:var(--accent); color:var(--accent-deep); transform:translateX(-2px); }
  .prod-back:focus-visible{ outline:2px solid var(--accent); outline-offset:2px; }

  .prod-origin{
    display:inline-block;
    font-size:0.7rem; font-weight:800; letter-spacing:0.2em; text-transform:uppercase;
    color:var(--accent-deep);
    margin-bottom:14px;
  }
  .prod-name{
    font-family:var(--serif);
    font-size:clamp(2.2rem, 4.6vw, 3.4rem);
    line-height:1.05; color:var(--ink);
    margin-bottom:10px;
  }
  .prod-subtitle{
    font-size:0.82rem; letter-spacing:0.06em; color:var(--ink-dim);
    margin-bottom:20px;
  }
  .prod-desc{
    color:var(--ink-dim); line-height:1.8; font-size:1.02rem;
    max-width:44ch; margin-bottom:28px;
  }

  .prod-notes{
    list-style:none; display:flex; flex-wrap:wrap; gap:8px;
    margin-bottom:30px;
  }
  .prod-notes li{
    font-size:0.68rem; font-weight:700; letter-spacing:0.14em; text-transform:uppercase;
    padding:7px 14px; border-radius:100px;
    border:1px solid var(--card-line);
    color:var(--ink);
    background:var(--card);
  }

  .prod-meters{
    display:flex; flex-wrap:wrap; gap:26px;
    padding:22px 0;
    border-top:1px solid var(--line);
    border-bottom:1px solid var(--line);
    margin-bottom:26px;
  }
  .meter{ display:flex; flex-direction:column; gap:9px; }
  .meter-label{
    font-size:0.64rem; font-weight:800; letter-spacing:0.18em; text-transform:uppercase;
    color:var(--ink-dim);
  }
  .meter-dots{ display:flex; gap:6px; }
  .meter-dots .dot{
    width:9px; height:9px; border-radius:50%;
    border:1px solid var(--accent);
    opacity:0.45;
    transition:background .4s ease, opacity .4s ease;
  }
  .meter-dots .dot.is-on{ background:var(--accent); opacity:1; }
  .meter-todo{
    font-size:0.6rem; letter-spacing:0.1em; text-transform:uppercase;
    color:var(--accent-deep); opacity:0.75;
  }

  .prod-facts{
    display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:18px 26px;
  }
  .prod-facts .fact dt{
    font-size:0.62rem; font-weight:800; letter-spacing:0.18em; text-transform:uppercase;
    color:var(--ink-dim); margin-bottom:5px;
  }
  .prod-facts .fact dd{ font-size:0.92rem; color:var(--ink); }

  /* Dato aún sin definir. Mismo lenguaje que los pendientes de la sección Contacto. */
  #tueste .is-pending{
    color:var(--accent-deep);
    opacity:0.75;
    font-style:italic;
    font-weight:400;
  }
  #tueste .prod-notes li.is-pending{ text-transform:none; letter-spacing:0.04em; }

  /* --- arte: bolsa + granos --- */
  .prod-art{
    position:relative; z-index:2;
    display:flex; align-items:flex-end; justify-content:center;
    /* Franja bajo la base del paquete donde el montón se ve entero. */
    padding-bottom:26px;
    min-height:clamp(360px, 46vh, 520px);
  }
  /* Delante de la bolsa, no detrás. Detrás, el montón se formaba justo donde el paquete
     lo tapa y solo se veían los dos o tres granos que caían por fuera. Delante se lee la
     acumulación en la base y los que caen cruzan el paquete, que es como se compone una
     foto de producto. */
  .prod-beans{
    position:absolute; inset:0;
    width:100%; height:100%;
    display:block; pointer-events:none;
    z-index:3;
  }
  .prod-pack{
    position:relative; z-index:2;
    width:clamp(190px, 22vw, 300px);
    filter:drop-shadow(0 30px 50px rgba(0,0,0,0.28));
    transition:opacity .22s ease, transform .22s ease;
  }
  .prod-pack.is-swapping{ opacity:0; transform:translateY(12px) scale(0.985); }
  .prod-pack svg, .prod-pack img{ width:100%; height:auto; display:block; }

  @media (prefers-reduced-motion: reduce){
    .pick-panel, .pick-tab, .product-stage, .roast-stage,
    .prod-copy, .prod-pack, .prod-bg-layer{ transition:none; }
  }


  /* ---------- SECTION GENERIC ---------- */
  section{ position:relative; padding:120px 0; background:var(--bg); }
  .section-alt{ background:var(--bg-alt); }
  .section-head{ max-width:640px; margin-bottom:64px; }
  .section-head h2{ font-size:clamp(2.1rem, 4.2vw, 3.2rem); color:var(--ink); }
  .section-head p{ color:var(--ink-dim); margin-top:18px; font-size:1.05rem; max-width:560px; }

  /* ---------- ABOUT ---------- */
  .about-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:60px;
    align-items:center;
  }
  .about-copy p{ color:var(--ink-dim); font-size:1.05rem; margin-bottom:18px; }
  .about-copy strong{ color:var(--accent-deep); font-weight:700; }

  .stats-row{
    display:grid;
    grid-template-columns:repeat(2, 1fr);
    gap:24px;
    margin-top:16px;
  }
  .stat{
    padding:30px 24px;
    background:var(--card);
    border:1px solid var(--card-line);
    border-radius:18px;
    text-align:left;
    box-shadow:0 14px 34px rgba(0,0,0,0.06);
  }
  .stat .num{
    font-family:var(--serif); font-size:clamp(2.4rem,5vw,3.4rem);
    color:var(--accent-deep); font-weight:600; line-height:1;
  }
  .stats-row .stat:nth-child(2) .num{ color:var(--blue-deep); }
  .stat .label{ margin-top:10px; color:var(--ink-dim); font-size:0.92rem; }

  .map-badge{
    position:relative;
    border-radius:24px;
    padding:44px;
    background:var(--card);
    border:1px solid var(--card-line);
    overflow:hidden;
    min-height:340px;
    display:flex; flex-direction:column; justify-content:center; gap:22px;
    box-shadow:0 14px 34px rgba(0,0,0,0.06);
  }
  .region-list{ display:flex; flex-direction:column; gap:14px; position:relative; z-index:1; }
  .region-item{
    display:flex; align-items:center; gap:14px;
    font-family:var(--serif); font-size:1.3rem; color:var(--ink);
  }
  .region-item .pip{
    width:9px; height:9px; border-radius:50%;
    background:var(--blue); flex-shrink:0;
    box-shadow:0 0 0 4px rgba(111,184,214,0.22);
  }

  #nosotros .container{ position:relative; }
  #nosotros .section-head,
  #nosotros .about-grid{ position:relative; z-index:1; }
  #contacto .container{ position:relative; z-index:1; }
  /* The shore occupies exactly the reserved band, so the padding and the canvas height
     are driven by one value and cannot drift apart. */
  #contacto{
    --shore-height:clamp(300px, 30vw, 420px);
    /* Headroom above the beach band so the occasional surge can climb in among the
       cards. The cards sit at z-index 1, so the water passes behind them. */
    --shore-surge:280px;
    padding-bottom:var(--shore-height);
  }
  .shore-layer{
    position:absolute;
    left:0; bottom:0;
    width:100%;
    height:calc(var(--shore-height) + var(--shore-surge));
    display:block;
    pointer-events:none;
    z-index:0;
  }

  /* ---------- DESERT SUNSET SCENE (#nosotros) ---------- */
  /* --desert-floor: distance from the section bottom up to the scene's ground line. */
  #nosotros{
    /* Transparent: the sky belongs to .sky-stage now and has to show straight through.
       The id beats the .section-alt class, which would otherwise paint grey over it. */
    background:transparent;
    /* Reserved band below the copy so the mesas, dunes and cacti have room of their own —
       without it the glass panels sit right on top of the terrain. Tracks .d-far's own
       clamp with roughly 150px of open sky added on top, so the clearance holds at every
       width instead of only at the one it was measured on. */
    padding-bottom:clamp(600px, 58vw, 800px);
  }

  .desert{
    position:absolute;
    left:0; right:0; top:0;
    bottom:var(--desert-floor);
    z-index:0;
    pointer-events:none;
    /* Clips the parallax travel. Kept on the scene rather than the section, because
       la escena de producto desborda deliberadamente los limites de la seccion. */
    overflow:hidden;
  }
  .desert-layer{
    position:absolute;
    background-repeat:no-repeat;
    will-change:transform, opacity;
    /* Bottom edge, so scaleY grows every layer up out of the ground. Harmless on the sky
       layers, which only ever translate. */
    transform-origin:50% 100%;
  }
  /* Only hidden once the script has taken control (see desert-scene.js). */
  .desert[data-anim] .desert-layer{ opacity:0; }
  /* Terrain bands stretch horizontally (background-size 100% 100%): these are abstract
     landscape polygons, so widening them reads as distance, not distortion. */
  .d-sky, .d-far, .d-mid, .d-near{ left:0; right:0; background-size:100% 100%; }
  /* The near dunes tile instead of stretching. Their character lives in the small
     shrubs along the crest, and stretching one 500-wide copy across the viewport
     flattens that edge into a straight line; tiling keeps the shrubs in proportion. */
  .d-near{ background-size:660px 100%; background-repeat:repeat-x; }

  /* The sky reproduces the four colours of "fondo atardecer.svg" but repositions the
     stops: that file is framed for a square canvas, where the bright band covers the
     lower 38% and would swallow the whole middle of a wide section. Here the glow is
     compressed into a strip that sits just above the mesa line. */
  .d-sky{
    top:0; bottom:0;
    /* Two layers: the horizon glow riding on top of the deep sky. The glow is a fixed
       560px band pinned to the ground line rather than a percentage of the element, so it
       stays put against the mesas no matter how tall the section grows. Its top stop is a
       transparent orange, not `transparent` — that keyword is transparent *black* and
       would drag a grey cast through the fade. */
    background-image:
      linear-gradient(to bottom, rgba(255,190,119,0) 0%, #ffbe77 26%, #fff997 40%, #fff997 100%),
      linear-gradient(to bottom, #460c6e 0%, #460c6e 10%, #b03c9a 66%, #c9527f 100%);
    background-size:100% 900px, 100% 100%;
    background-position:center bottom, center top;
    background-repeat:no-repeat, no-repeat;
  }
  /* Sized for its travel, not for its resting position. The band carries the second
     largest lag (~+/-353px), so it has to stay far taller than the sky it covers and tile
     on both axes — otherwise a scroll extreme slides the solid part of the mask out of
     view and the stars simply vanish. The top is always clipped by the scene and the
     bottom always dissolves, so no edge is ever visible. */
  .d-stars{
    left:0; right:0; top:-700px;
    /* Tied to the stage height now that the sky spans the hero as well: a fixed band
       would run out partway down and the stars would stop halfway. */
    height:calc(100% + 700px);
    background-image:url('assets/desierto/SVG/estrellas.svg');
    background-size:640px auto;
    background-repeat:repeat;
    -webkit-mask-image:linear-gradient(to bottom, #000 0%, #000 58%, transparent 86%);
    mask-image:linear-gradient(to bottom, #000 0%, #000 58%, transparent 86%);
    /* Dimmer than it was: the field used to sit behind the glass panels of one section,
       and at full strength across an open hero it speckles the copy. */
    opacity:0.72;
  }
  .d-sun{
    /* Anchored to the TOP of the stage, not the ground line: it has to be up in the hero
       when the page loads. From there the largest lag of any layer walks it down through
       the sky as you scroll into the second section. */
    right:11%; top:clamp(122px, 19vh, 232px); bottom:auto;
    width:clamp(112px, 12.5vw, 190px); height:clamp(112px, 12.5vw, 190px);
    background-image:url('assets/desierto/SVG/luna.svg');
    background-size:contain;
  }
  /* The "-w" copies carry preserveAspectRatio="none" so they stretch to the section
     width; the stock files letterbox their artwork centered instead. See make-scene-assets.py.
     Heights are staged so each ridge clears the one in front of it: the far mesas read
     above the middle ridge, and the middle ridge above the near dunes.

     The two moving bands carry a second background — a flat block matching the colour
     their gradient settles into — sitting directly beneath the artwork and running past
     the ground line. Without it, riding up under parallax would tear a strip of sky open
     along the horizon. The near dunes need none: they hold still as the ground line. */
  /* Ridge height is a single custom property per band, because it has to appear in three
     places at once: the artwork's size, where the colour block starts underneath it, and
     the element's own height. Writing the number three times is how these drifted apart
     before. It is also a clamp rather than a fixed height — the open sky reserved above
     the terrain scales with the viewport, so a ridge frozen in pixels grew into the copy
     on middling screens while leaving a gap on wide ones. */
  .d-far{
    --ridge:clamp(420px, 43vw, 630px);
    bottom:-260px; height:calc(var(--ridge) + 260px);
    background-image:url('assets/desierto/SVG/desierto3-w.svg'), linear-gradient(#d36e4b, #d36e4b);
    background-size:100% var(--ridge), 100% 260px;
    background-position:left top, left var(--ridge);
    background-repeat:no-repeat, repeat-x;
  }
  .d-mid{
    --ridge:clamp(335px, 34vw, 500px);
    bottom:-260px; height:calc(var(--ridge) + 260px);
    background-image:url('assets/desierto/SVG/desierto2-w.svg'), linear-gradient(#b63a59, #b63a59);
    background-size:100% var(--ridge), 100% 260px;
    background-position:left top, left var(--ridge);
    background-repeat:no-repeat, repeat-x;
  }
  .d-near{ bottom:0; height:130px; background-image:url('assets/desierto/SVG/desierto_1-w.svg'); }

  .desert-cactus{ background-size:contain; background-position:bottom center; }
  /* Mid-distance cacti (#97294e, #aa3946) stand on the middle ridge, tucked behind the
     near dunes. Foreground cacti (#670d46) share the dunes' exact colour, so the part
     below the crest melts into it and only the silhouette above shows. */
  .d-c5{ left:14%;  bottom:118px; width:30px; height:82px;  background-image:url('assets/desierto/SVG/cactus5.svg'); }
  .d-c4{ left:73%;  bottom:120px; width:34px; height:112px; background-image:url('assets/desierto/SVG/cactus4.svg'); }
  /* Foreground trio, sized well past the mid-distance pair to sell the depth gap. Widths
     follow each file's own aspect so nothing is squashed. They share the dunes' colour,
     so whatever falls below the crest merges into it and only the silhouette reads.
     Bases are set below the ground line and the heights padded to match, so that at peak
     parallax rise (lag x TRAVEL: 109px, 84px and 67px) each foot still lands under the
     ~100px crest and no cut-off base is ever exposed. */
  .d-c2{ left:2%;   bottom:-40px; width:103px; height:400px; background-image:url('assets/desierto/SVG/cactus2.svg'); }
  .d-c1{ left:66%;  bottom:-20px; width:87px;  height:250px; background-image:url('assets/desierto/SVG/cactus1.svg'); }
  .d-c3{ left:87%;  bottom:-10px; width:82px;  height:255px; background-image:url('assets/desierto/SVG/cactus3.svg'); }

  /* ---------- #nosotros copy over the scene: light type + glass panels ---------- */
  #nosotros .section-head h2{ color:#FDFBF4; }
  #nosotros .section-head p{ color:rgba(255,248,240,0.88); }
  #nosotros .eyebrow{ color:var(--accent-light); }
  #nosotros .eyebrow::before{ background:var(--accent-light); }

  /* The lower block crosses the stretch where the sky brightens toward the horizon,
     so it rides on translucent panels rather than trying to win on text colour alone. */
  #nosotros .about-copy,
  #nosotros .map-badge{
    background:rgba(44,10,58,0.44);
    -webkit-backdrop-filter:blur(14px) saturate(120%);
    backdrop-filter:blur(14px) saturate(120%);
    border:1px solid rgba(255,255,255,0.16);
    border-radius:22px;
    box-shadow:0 20px 50px rgba(20,4,30,0.30);
  }
  #nosotros .about-copy{ padding:36px 34px 34px; }
  #nosotros .about-copy p{ color:rgba(255,248,240,0.88); }
  #nosotros .about-copy strong{ color:var(--accent-light); }
  #nosotros .stat{
    background:rgba(255,255,255,0.09);
    border:1px solid rgba(255,255,255,0.15);
    box-shadow:none;
  }
  #nosotros .stat .num{ color:var(--accent-light); }
  #nosotros .stats-row .stat:nth-child(2) .num{ color:var(--blue-light); }
  #nosotros .stat .label{ color:rgba(255,248,240,0.76); }
  #nosotros .region-item{ color:#FDFBF4; }
  .region-item.is-wide{
    grid-column:1 / -1;
    font-size:1.35rem;
  }
  .region-note{
    grid-column:1 / -1;
    margin-top:6px;
    font-size:0.82rem; line-height:1.6;
    color:rgba(255,248,240,0.78);
  }
  #nosotros .region-item .pip{
    background:var(--blue-light);
    box-shadow:0 0 0 4px rgba(185,225,240,0.22);
  }

  .cafe-note{
    margin-top:30px; font-size:0.9rem; color:var(--ink-dim); font-style:italic;
  }

  /* ---------- CONTACT ---------- */
  .contact-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:60px;
  }
  .contact-list{ display:flex; flex-direction:column; gap:22px; margin-top:8px; }
  .contact-item{
    display:flex; align-items:center; gap:18px;
    padding:20px 22px;
    background:var(--card);
    border:1px solid var(--card-line);
    border-radius:16px;
    box-shadow:0 10px 26px rgba(0,0,0,0.05);
    transition:border-color 0.3s ease, transform 0.3s ease;
  }
  .contact-item:hover{ border-color:var(--accent); transform:translateX(6px); }
  .contact-icon{
    width:44px; height:44px; border-radius:50%;
    background:linear-gradient(135deg, var(--accent-light), var(--accent));
    display:flex; align-items:center; justify-content:center;
    flex-shrink:0; color:#141414;
  }
  .contact-item .label{ font-size:0.78rem; text-transform:uppercase; letter-spacing:0.12em; color:var(--ink-dim); }
  .contact-item .value{ font-family:var(--serif); font-size:1.15rem; color:var(--ink); margin-top:2px; }
  .contact-item.pending .value{ color:var(--accent-deep); font-family:var(--sans); font-size:0.95rem; }

  form.contact-form{
    background:var(--card); border:1px solid var(--card-line);
    border-radius:22px; padding:40px;
    box-shadow:0 14px 34px rgba(0,0,0,0.06);
  }
  .form-row{ margin-bottom:20px; }
  .form-row label{ display:block; font-size:0.82rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--ink-dim); margin-bottom:8px; }
  .form-row input, .form-row textarea{
    width:100%; padding:14px 16px;
    background:var(--bg);
    border:1px solid var(--line);
    border-radius:12px;
    color:var(--ink);
    font-family:var(--sans); font-size:0.95rem;
    resize:vertical;
  }
  .form-row input:focus, .form-row textarea:focus{ outline:none; border-color:var(--accent); }
  form.contact-form .btn{ width:100%; }

  footer{
    padding:50px 0 30px;
    border-top:1px solid var(--line);
    background:var(--bg);
  }
  .footer-inner{
    display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:20px;
  }
  .footer-brand{ display:flex; align-items:center; gap:12px; }
  .footer-brand .brand-mark{ width:34px; height:34px; }
  .footer-copy{ font-size:0.85rem; color:var(--ink-dim); }
  .footer-social{ display:flex; gap:16px; }
  .footer-social a{
    width:38px; height:38px; border-radius:50%; border:1px solid var(--line);
    display:flex; align-items:center; justify-content:center;
    color:var(--ink-dim); transition:all 0.3s ease;
  }
  .footer-social a:hover{ color:var(--accent-deep); border-color:var(--accent); transform:translateY(-3px); }

  /* ---------- REVEAL ANIMATIONS ---------- */
  .reveal{
    opacity:0; transform:translateY(36px);
    transition:opacity 0.8s cubic-bezier(.2,.8,.2,1), transform 0.8s cubic-bezier(.2,.8,.2,1);
  }
  .reveal.is-visible{ opacity:1; transform:none; }
  .reveal-scale{ opacity:0; transform:scale(0.92); transition:opacity 0.8s ease, transform 0.8s cubic-bezier(.2,.8,.2,1); }
  .reveal-scale.is-visible{ opacity:1; transform:none; }

  /* ---------- RESPONSIVE ---------- */

  /* ---------- ESCENA DE PRODUCTO ---------- */
  /* El render va a sangre completa de la seccion y el texto se lee encima, a la
     izquierda, sobre un velo que oscurece ese lado. */
  .product-stage.has-scene{
    position:relative;
    grid-template-columns:1fr;
    /* start y no center: centrada, la fila se redimensionaba con el margen negativo de la
       ficha y se recolocaba sola, asi que el bloque solo subia un tercio de lo pedido. */
    align-content:start;
    min-height:clamp(500px, 44vw, 760px);
    /* Sin hueco propio: el fondo cubre de borde a borde y la ficha va superpuesta. */
    gap:0;
  }

  .prod-scene{
    position:absolute;
    /* Se estira más allá de la caja del escenario para tapar también el relleno vertical
       de la sección. Sin esto quedaba una franja blanca entre "Nuestro origen" y el
       principio de la ficha. --sec-pad vale lo que el padding de section. */
    top:calc(-1 * var(--sec-pad));
    bottom:calc(-1 * var(--sec-pad));
    /* En escritorio da igual porque va en absoluto, pero en móvil vuelve al flujo y en el
       DOM está detrás de la ficha: sin esto la banda salía debajo del texto. */
    order:-1;
    /* Sale del .container para ocupar el ancho entero. Absoluto y centrado sobre la caja
       de relleno: asi la sangria que empuja el texto cuando se abre el panel no arrastra
       tambien al fondo. #tueste lleva overflow-x:clip, que evita el scroll horizontal que
       el 100vw provocaria por el ancho de la barra de desplazamiento. */
    left:50%;
    width:100vw;
    transform:translateX(-50%);
    overflow:hidden;
    z-index:0;
    border-radius:0;
    box-shadow:none;
  }

  /* Fondo quieto: ni parallax ni zoom de entrada. Solo aparece. */
  .scene-backdrop{
    position:absolute;
    inset:0;
    background-repeat:no-repeat;
    /* --scene-size y --scene-pos las escribe el JS desde los datos de cada café. */
    background-size:var(--scene-size, cover);
    background-position:var(--scene-pos, center);
    opacity:0;
    transition:opacity .9s ease;
  }
  .scene-in .scene-backdrop{ opacity:1; }

  /* Los granos van por encima del render: se posan en el canto de la roca de la foto. */
  .scene-beans{
    position:absolute; inset:0;
    width:100%; height:100%;
    display:block; pointer-events:none;
    z-index:1;
    opacity:0;
    transition:opacity .8s ease .35s;
  }
  .scene-in .scene-beans{ opacity:1; }

  /* Velo lateral: el render tiene cactus y zorro en el lado izquierdo, y el texto en
     crema sobre ese dibujo no se leeria. Se apaga hacia el centro para no tocar la bolsa. */
  /* Sin velo: el texto va directamente sobre el render. */

  /* --- la ficha, superpuesta a la izquierda --- */
  /* Manto blanco muy suave detras del texto: el render es una foto a contraluz y sin el
     los datos mas pequenos se apoyan en piedra y matorral. Se deshace hacia la bolsa para
     no lavarla. */
  .product-stage.has-scene .prod-copy::before{
    content:'';
    position:absolute;
    /* Sin backdrop-filter: el desenfoque dibujaba un canto recto sobre la bolsa y la
       dejaba lavada. Solo un degradado suave, y se apaga antes de llegar al paquete. */
    inset:-4% -2% -4% -9%;
    background:
      linear-gradient(96deg,
        rgba(255,255,255,0.88) 0%,
        rgba(255,255,255,0.82) 44%,
        rgba(255,255,255,0.52) 74%,
        rgba(255,255,255,0) 98%);
    /* El degradado solo va en horizontal, asi que arriba y abajo cortaba en recto. La
       mascara le deshace tambien esos dos cantos. */
    -webkit-mask-image:linear-gradient(to bottom, transparent 0, #000 14%, #000 86%, transparent 100%);
    mask-image:linear-gradient(to bottom, transparent 0, #000 14%, #000 86%, transparent 100%);
    z-index:-1;
    pointer-events:none;
  }
  .product-stage.has-scene .prod-copy{
    position:relative;
    z-index:2;
    /* Arrimada arriba y no centrada: centrada, su ultima fila caia sobre la piedra del
       render y el texto se leia contra el granito. */
    align-self:start;
    /* Sin sangria propia: arranca en el borde del .container, en la misma vertical que
       los parrafos del resto de la web. */
    max-width:min(560px, 100%);
    padding:0 0 clamp(30px, 4vh, 56px);
    /* Sube por encima del borde del .container, aprovechando el relleno de la seccion:
       el fondo llega hasta ahi, asi que el bloque sigue apoyado sobre cielo y deja mas
       piedra libre por abajo. */
    margin-top:calc(-1 * clamp(40px, 8vh, 104px));
  }
  .product-stage.has-scene .prod-copy > *{
    opacity:0;
    transform:translateY(16px);
    transition:opacity .7s ease, transform .8s cubic-bezier(0.22,1,0.36,1);
  }
  /* Se repite `.has-scene` en el selector que enciende: la regla que apaga lleva dos
     clases mas el descendiente, asi que sin esto gana ella y el texto no aparece nunca. */
  .product-stage.has-scene.scene-in .prod-copy > *{ opacity:1; transform:none; }
  /* Cascada: cada bloque entra detras del anterior, ya montado el fondo. */
  .product-stage.has-scene.scene-in .prod-copy > *:nth-child(1){ transition-delay:.34s; }
  .product-stage.has-scene.scene-in .prod-copy > *:nth-child(2){ transition-delay:.42s; }
  .product-stage.has-scene.scene-in .prod-copy > *:nth-child(3){ transition-delay:.50s; }
  .product-stage.has-scene.scene-in .prod-copy > *:nth-child(4){ transition-delay:.58s; }
  .product-stage.has-scene.scene-in .prod-copy > *:nth-child(5){ transition-delay:.66s; }
  .product-stage.has-scene.scene-in .prod-copy > *:nth-child(6){ transition-delay:.74s; }
  .product-stage.has-scene.scene-in .prod-copy > *:nth-child(7){ transition-delay:.82s; }
  .product-stage.has-scene.scene-in .prod-copy > *:nth-child(8){ transition-delay:.90s; }

  /* Tipografia en negro sobre el render, igual que el resto de la web. Sin velo detras,
     asi que el contraste depende del trozo de foto que quede debajo. */
  .product-stage.has-scene .prod-back{
    border-color:var(--card-line); color:var(--ink);
  }
  .product-stage.has-scene .prod-back:hover{
    border-color:var(--accent); color:var(--accent-deep);
  }
  /* También en negro. Medido sobre la foto, el naranja de marca se queda en 1,7:1 —el
     atardecer tiene casi su misma luminosidad— y en negro sube por encima de 7:1. Los
     datos pendientes se siguen distinguiendo por la cursiva. */
  .product-stage.has-scene .prod-origin{ color:var(--ink); }
  .product-stage.has-scene .prod-name{ color:var(--ink); text-shadow:none; }
  .product-stage.has-scene .prod-subtitle{ color:var(--ink); }
  .product-stage.has-scene .prod-desc{ color:var(--ink); }
  .product-stage.has-scene .prod-notes li{
    background:rgba(255,255,255,0.62);
    border-color:rgba(0,0,0,0.18);
    color:var(--ink);
    backdrop-filter:blur(4px);
    -webkit-backdrop-filter:blur(4px);
  }
  .product-stage.has-scene .prod-meters{ border-color:rgba(0,0,0,0.22); }
  /* Tres columnas y no dos: con dos, los seis datos ocupaban tres filas y la ultima caia
     sobre la piedra del render. En tres caben en dos filas y el bloque termina antes. */
  .product-stage.has-scene .prod-facts{
    grid-template-columns:repeat(3, minmax(0,1fr));
    gap:16px 20px;
  }
  .product-stage.has-scene .meter-label,
  .product-stage.has-scene .prod-facts .fact dt{ color:var(--ink); }
  .product-stage.has-scene .prod-facts .fact dd{ color:var(--ink); }
  .product-stage.has-scene .meter-dots .dot{ border-color:var(--accent-deep); }
  .product-stage.has-scene .meter-dots .dot.is-on{ background:var(--accent-deep); }
  /* Con #tueste delante: la regla general de pendientes es `#tueste .is-pending`, y un
     ID gana a tres clases, así que sin esto el dato de altitud seguía en naranja — 1,7:1
     sobre el atardecer, ilegible. */
  #tueste .product-stage.has-scene .meter-todo,
  #tueste .product-stage.has-scene .is-pending{ color:var(--ink); opacity:0.72; }

  /* La bolsa suelta y los granos son el respaldo de los cafes sin render: aqui la bolsa
     ya esta dentro de la composicion. */
  .product-stage.has-scene .prod-art{ display:none; }
  /* El halo de color de reserva sobra: el render ya trae su propia atmósfera. */
  .product-stage.has-scene .prod-bg{ display:none; }

  @media (prefers-reduced-motion: reduce){
    .scene-backdrop, .product-stage.has-scene .prod-copy > *{
      transition:none;
    }
  }

  @media (max-width: 1180px){
    :root{ --panel-w:clamp(260px, 30vw, 330px); }
    /* En una sola columna el bloque es más bajo que la narrativa, y como los dos estados
       comparten celda para no provocar salto, centrarlo dejaba un vacío grande encima.
       Arrimado al inicio, la holgura sobrante se lee como aire al pie de la sección. */
    .product-stage{ grid-template-columns:1fr; gap:26px; align-content:start; }
    /* Menos ancho útil: el texto se lleva algo más de la mitad. */
    .product-stage.has-scene .prod-copy{ max-width:min(58%, 460px); }
    .prod-copy{ max-width:none; }
    /* Apilado en una sola columna el bloque crece, y si supera a la narrativa la sección
       se estira al abrirla. Recortando aquí el alto del arte, los dos estados miden
       prácticamente lo mismo y no se mueve nada debajo. */
    .prod-art{ min-height:clamp(230px, 30vh, 330px); }
    .prod-pack{ width:clamp(170px, 30vw, 240px); }
  }

  /* Por debajo de 900px no caben las dos cosas a la vez: una columna de texto de 480px
     sobre una imagen de 820 deja a la bolsa sin sitio y el encuadre la expulsa del cuadro.
     El fondo pasa a banda a sangre en la parte de arriba y la ficha va debajo, en oscuro
     sobre claro como el resto de la web. */
  @media (max-width: 900px){
    /* Sticky contra el pie de la ventana: con `bottom` no llega a engancharse nunca (su
       posición natural nunca cae por debajo) y la pestaña se va con el scroll. Fijando
       `top` a una altura de ventana menos su alto, queda abajo y al alcance del pulgar.
       Aquí es obligado: el texto arranca en el borde del .container y con la pestaña a
       media altura le caía justo encima del título. */
    /* Anclada por `bottom`, no por `top: 100svh - algo`. Con position:fixed, `bottom` se
       resuelve contra el borde inferior de la ventana sin pasar por ninguna unidad de
       altura, asi que la barra del navegador no la puede arrastrar. */
    .pick-tab{ --tab-anchor:bottom; top:auto; bottom:22px; padding:10px 13px 10px 11px; gap:9px; }
    .pick-bean{ width:16px; height:24px; }
    /* Pista libre al final de cada bloque para que no acabe sobre la última línea. */
    .roast-stage, .product-stage{ padding-bottom:76px; }

    .product-stage.has-scene{ min-height:0; align-content:start; }
    .prod-scene{
      position:relative; left:auto; top:auto; bottom:auto; transform:none;
      width:100vw; margin-left:calc(50% - 50vw);
      height:min(56vh, 380px);
      /* Sube a pegarse al borde de la sección: la banda va arriba del todo y el relleno
         blanco por encima sobra igual que en escritorio. */
      margin-top:calc(-1 * var(--sec-pad));
      margin-bottom:26px;
    }
    /* Con el texto debajo ya no hay que despejar la izquierda: el encuadre se centra
       para que la bolsa salga entera, que es lo que cuenta aquí. */
    .scene-backdrop{ inset:-4% 0; --scene-size:cover; --scene-pos:center 56%; }
    .product-stage.has-scene .prod-copy{ max-width:none; padding:0; color:var(--ink); }
    /* En móvil el texto va debajo del fondo, no encima: la pestaña ya no lo pisa. */
    .product-stage.has-scene .prod-back{ border-color:var(--card-line); color:var(--ink-dim); }
    .product-stage.has-scene .prod-origin{ color:var(--accent-deep); }
    .product-stage.has-scene .prod-name{ color:var(--ink); text-shadow:none; }
    .product-stage.has-scene .prod-subtitle,
    .product-stage.has-scene .prod-desc{ color:var(--ink-dim); }
    .product-stage.has-scene .prod-notes li{
      background:var(--card); border-color:var(--card-line); color:var(--ink);
      backdrop-filter:none; -webkit-backdrop-filter:none;
    }
    .product-stage.has-scene .prod-meters{ border-color:var(--line); }
    .product-stage.has-scene .meter-label,
    .product-stage.has-scene .prod-facts .fact dt{ color:var(--ink-dim); }
    .product-stage.has-scene .prod-facts .fact dd{ color:var(--ink); }
    .product-stage.has-scene .meter-dots .dot{ border-color:var(--accent); }
    .product-stage.has-scene .meter-dots .dot.is-on{ background:var(--accent); }
    .product-stage.has-scene .meter-todo,
    .product-stage.has-scene .is-pending{ color:var(--accent-deep); }
  }

  @media (max-width: 900px){
    .about-grid, .contact-grid{ grid-template-columns:1fr; }
    .stats-row{ grid-template-columns:1fr 1fr; }
  }

  @media (max-width: 760px){
    #tueste{ --sec-pad:80px; }
    /* La pestaña sigue accesible, pero el panel deja de ser una franja estrecha: pasa
       a hoja inferior a pantalla casi completa, y al elegir un café se cierra sola. */
    :root{ --panel-w:0px; }
    .roast-phases{ grid-template-columns:repeat(3, 1fr); gap:20px 10px; }
    .roast-phases li::after{ display:none; }

    body.t-open .pick-label,
    body.t-show .pick-label{ max-width:14ch; opacity:1; }
    /* Con la hoja abierta la pestaña no aporta: la hoja trae su propio cierre. */
    body.t-open .pick-tab{ opacity:0; pointer-events:none; }
    .pick-label{ font-size:0.6rem; letter-spacing:0.13em; }
    body.t-open .pick-tab{ --tab-x:0px; }
    body.t-open .pick-tab:hover{ --tab-x:0px; }
    .pick-panel{
      position:fixed;
      left:0; right:0; bottom:0; top:auto;
      /* max-width:none es imprescindible. La regla de escritorio limita el cajon a 34vw,
         y esa limitacion tambien alcanzaba a la hoja: con left:0 y right:0 puestos pero
         el ancho topado en 34vw, la caja se resolvia contra el borde izquierdo y la hoja
         salia como un panel estrecho pegado a la izquierda en vez de a lo ancho por
         abajo. Es justo lo que se veia en pantalla pequeña. */
      width:auto; max-width:none; max-height:82vh;
      border-left:none; border-right:none;
      border-radius:22px 22px 0 0;
      transform:translateY(101%);
      box-shadow:0 -20px 60px rgba(0,0,0,0.24);
      z-index:120;
    }
    body.t-open .pick-panel{ transform:none; }
    .pick-scrim{ z-index:119; }
    .product-stage{ padding-left:0 !important; min-height:0; }
    /* Superponer no cabe en 390px: el texto taparia la bolsa entera. El fondo pasa a ser
       una banda a sangre en la parte de arriba y la ficha va debajo, en oscuro sobre
       claro como el resto de la web. */
    /* (la escena apilada vive ahora en su propio bloque de 900px) */
    .prod-facts{ gap:16px 20px; }
    .prod-meters{ gap:20px; }

    .nav-links, .nav-pill .nav-cta{ display:none; }
    /* The hidden links and button vacate their grid cells entirely, so without an explicit
       column the burger slides up next to the logo instead of holding the right edge. */
    .burger{ display:flex; grid-column:3; }
    .nav-pill{ padding-left:14px; }
    /* Two short lines beat one long wrapped one on a 390px screen. */
    .hero-kicker{ font-size:0.62rem; letter-spacing:0.18em; padding:8px 16px; }
    .hero{ padding-top:clamp(112px, 15vh, 150px); }
    section{ padding:80px 0; }

    /* Narrow screens: shorter terrain, a tighter scene band, and the two smallest
       cacti dropped so the foreground doesn't crowd. */
    .sky-stage{ --desert-floor:0px; }
    #nosotros{ padding-bottom:560px; }
    .roast-grid{ grid-template-columns:1fr; }
    #contacto{ --shore-surge:200px; }
    .d-far{ --ridge:360px; }
    .d-mid{ --ridge:285px; }
    .d-near{ height:85px; }
    /* Glow band shortened to sit against the lower mesas here. */
    .d-sky{ background-size:100% 560px, 100% 100%; }
    .d-stars{ background-size:420px auto; }
    .d-sun{ right:8%; top:clamp(104px, 15vh, 150px); width:96px; height:96px; }
    /* Bases pushed well below the ground line (and clipped there): the near dunes are only
       58px on narrow screens, so there is far less crest to hide a rising foot behind. */
    .d-c2{ left:2%;  bottom:-80px; width:67px; height:330px; }
    .d-c1{ left:64%; bottom:-50px; width:57px; height:210px; }
    .d-c4{ left:80%; bottom:78px;  width:23px; height:75px; }
    .d-c3, .d-c5{ display:none; }
    #nosotros .about-copy{ padding:28px 24px 26px; }
  }

  .mobile-menu{
    position:fixed; inset:0; z-index:99;
    /* Fully opaque: the hero behind it is dark now, and the old 98% let the headline
       ghost through the panel. */
    background:#FFFFFF;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    gap:34px;
    transform:translateY(-100%);
    transition:transform 0.45s cubic-bezier(.2,.8,.2,1);
  }
  .mobile-menu.open{ transform:translateY(0); }
  .mobile-menu a{ font-family:var(--serif); font-size:1.8rem; color:var(--ink); }
  .mobile-menu .close-btn{
    position:absolute; top:22px; right:24px;
    width:40px; height:40px; border:1px solid var(--line); border-radius:10px;
    display:flex; align-items:center; justify-content:center; color:var(--ink); background:transparent;
  }

  /* ---------- SAND GRAIN OVERLAY (scoped to flat-color sections only) ---------- */
  /* Painted as real sand (own color, normal blending) — an overlay/multiply blend
     over a near-white backdrop can only ever wash out, never read as sand. */
  .sand-layer{
    position:absolute;
    left:0; top:0;
    width:100%;
    display:block;
    pointer-events:none;
    opacity:1;
    z-index:0;
  }
  #sandContacto, #sandContactoTrail{ height:100%; }
  /* Body copy sitting directly on the sand needs a darker ink — the default dim gray
     only reaches ~3.8:1 against a lit sand backdrop, under the readable minimum. */
  #contacto .section-head p{ color:#3A352E; }
  @media (prefers-reduced-motion: reduce){
    .sand-layer{ opacity:0.75; }
  }
